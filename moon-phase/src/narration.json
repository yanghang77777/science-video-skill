{
  "s1": {
    "title": "钩子",
    "lines": ["抬头看，亮着的只有一弯", "圆的另一边，好像没了"]
  },
  "s2": {
    "title": "误区",
    "lines": ["三条排齐，影子才罩住", "那是月食，不是每月圆缺"]
  },
  "s3": {
    "title": "原理",
    "lines": ["月亮自己并不发光", "太阳永远只照亮一半"]
  },
  "s4": {
    "title": "核心演示",
    "lines": ["左边太空，右边地面", "同一颗月亮，两个视角", "弯月走到上弦，再到满月"]
  },
  "s5": {
    "title": "大小不变",
    "lines": ["满月沿着轨道继续走", "亮面在缺，圆盘一样大"]
  },
  "s6": {
    "title": "总结",
    "lines": ["新月、上弦、满月、下弦", "八种月相，接成一整圈"]
  }
}
