{
  "s1": {
    "title": "钩子",
    "lines": ["隔着几千公里打电话", "对方怎么能听见你"]
  },
  "s2": {
    "title": "误区",
    "lines": ["不是声音顺着线跑", "传过去的其实是信号"]
  },
  "s3": {
    "title": "原理",
    "lines": ["空气微粒只在原地振动", "话筒把振动变成电压", "出来是连续起伏的电信号"]
  },
  "s4": {
    "title": "核心",
    "lines": ["先按时间取下一串样点", "再把高低量化成格子", "编码压缩打成数据包", "无线电只发到附近基站", "光纤里走的是光信号"]
  },
  "s5": {
    "title": "座机",
    "lines": ["老座机这一段可以是电流", "长途网不是整段都这样"]
  },
  "s6": {
    "title": "还原",
    "lines": ["数字还原成电信号", "扬声器振动，声音回来"]
  }
}
